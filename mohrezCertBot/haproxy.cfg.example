global
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # Default SSL material locations
    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private

    # SSL Ciphers and options
    ssl-default-bind-ciphers ECDH+AESGCM:DH+AESGCM:ECDH+AES256:DH+AES256:ECDH+AES128:DH+AES:RSA+AESGCM:RSA+AES:!aNULL:!MD5:!DSS
    ssl-default-bind-options ssl-min-ver TLSv1.2
    tune.ssl.default-dh-param 2048

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

# Frontend terminating SSL using PEM generated by mohrezCertBot.sh
frontend https_front
    # You can bind individual certificates or specify crt-list / directory:
    # Example 1: Single domain cert generated by mohrezCertBot:
    # bind *:443 ssl crt /etc/haproxy/yourdomain.com.pem alpn h2,http/1.1
    # Example 2: Directory or crt-list:
    bind *:443 ssl crt /etc/haproxy/ alpn h2,http/1.1
    mode http

    # Route traffic based on Host header or ALPN
    use_backend nginx_backend if { ssl_fc_sni -i yourdomain.com }
    default_backend nginx_backend

backend nginx_backend
    mode http
    server nginx_server 127.0.0.1:8080 check
